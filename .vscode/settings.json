{
    "git.ignoreLimitWarning": true,
    "liveServer.settings.port": 5501,

    // ── Python interpreter (venv) ─────────────────────────────────────────
    // TWO keys are required: defaultInterpreterPath (what VS Code uses to run
    // Python) and analysis.venvPath+venv (what Pylance/Pyright uses for import
    // resolution). Missing either key causes red import squiggles even when the
    // other key is set correctly.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    // Use a relative path for venvPath — avoids mis-expansion of ${workspaceFolder}
    // on Windows paths that contain spaces (e.g. "app advanced").
    "python.analysis.venvPath": ".",
    "python.analysis.venv": ".venv",

    // ── Pylance / pyright analysis extras ────────────────────────────────
    // Makes the image_service/ directory a recognised package root so
    // `from image_service.main import ...` resolves cleanly in tests.
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/image_service"
    ],

    // ── Lint / format settings ────────────────────────────────────────────
    "python.analysis.typeCheckingMode": "basic",

    // ── Silence false-positive import warnings ────────────────────────────
    // Pylance can still emit red squiggles on spaces-in-path workspaces even
    // when venv is correctly configured. This override keeps the editor 100%
    // clean without masking real errors (type errors still surface normally).
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    },
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.python"
    }
}